<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>PLORP_IAP;UNITY_ANDROID</DefineConstants>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);SYSLIB0021;SYSLIB0022;CS0649;CS0618;CA2022;CA2200</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Shop/ShopCatalog.cs" Link="Production/ShopCatalog.cs" />
    <Compile Include="../../Assets/Scripts/Shop/PurchaseDeliveryJournal.cs" Link="Production/PurchaseDeliveryJournal.cs" />
    <Compile Include="../../Assets/Scripts/Shop/GooglePlayReceiptValidation.cs" Link="Production/GooglePlayReceiptValidation.cs" />
    <Compile Include="../../Assets/Scripts/Shop/PurchaseService.cs" Link="Production/PurchaseService.cs" />
    <Compile Include="../../Assets/Editor/GooglePlayPublicKeyFormat.cs" Link="Production/GooglePlayPublicKeyFormat.cs" />
    <!-- Exercise Unity's real signature validator from the installed package, not a crypto mock. -->
    <Compile Include="../../Library/PackageCache/com.unity.purchasing@*/Runtime/Security/**/*.cs" Exclude="../../Library/PackageCache/com.unity.purchasing@*/Runtime/Security/AssemblyInfo.cs" />
    <Compile Include="../../Library/PackageCache/com.unity.purchasing@*/Runtime/SecurityCore/*.cs" Exclude="../../Library/PackageCache/com.unity.purchasing@*/Runtime/SecurityCore/AssemblyInfo.cs" />
    <Compile Include="../../Library/PackageCache/com.unity.purchasing@*/Runtime/Utilities/MiniJSON.cs" />
  </ItemGroup>
</Project>
